# ═══════════════════════════════════════════════════════════════════════════
# Sluxa Backend — Environment Configuration
# Copy this to backend/.env and fill in your keys
# ═══════════════════════════════════════════════════════════════════════════

# ── AI Provider ───────────────────────────────────────────────────────────
# Provider: 'groq' or 'gemini'
AI_PROVIDER=groq
AI_MODEL=qwen/qwen3.8-27b
AI_TEMPERATURE=0.9
AI_TOP_P=0.95
AI_MAX_TOKENS=2048

# Groq API Key (from https://console.groq.com/keys)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Google Gemini API Key (Optional — leave empty for Groq-only mode)
# Required if AI_PROVIDER=gemini or if RAG_ENABLED=true (for embeddings)
GOOGLE_API_KEY=

# ── Clerk Authentication ─────────────────────────────────────────────────
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxx

# ── Database ──────────────────────────────────────────────────────────────
# Docker Compose overrides this to sqlite:////data/slusha.db automatically
DATABASE_URL=sqlite:///./slusha.db

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins (*.vercel.app is auto-allowed via regex)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── RAG / Pinecone ────────────────────────────────────────────────────────
# Set RAG_ENABLED=false if running Groq-only (Groq has no embedding models)
RAG_ENABLED=false
PINECONE_API_KEY=
PINECONE_INDEX_NAME=slusha

# ── Proactive Messaging ──────────────────────────────────────────────────
PROACTIVE_ENABLED=true
